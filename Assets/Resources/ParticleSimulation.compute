#pragma kernel ResetParticles
#pragma kernel ApplyModule

struct ParticleData
{
    float3 position;
    float age;
    float3 velocity;
    float lifetime;
    float4 color;
    float size;
    float initialSize;
    float3 rotation;
    float3 angularVelocity;
    uint alive;
    uint seed;
};

RWStructuredBuffer<ParticleData> _Particles;
int _ParticleCapacity;
int _ModuleType;
int _Target;
int _Seed;
float _DeltaTime;
float _TimeValue;
float _Strength;
float3 _Vector;
float3 _Axis;
float _ScaleValue;
float _Speed;
float _Secondary;
float3 _EmitterOffset;
float3 _EmitterSize;
float3 _LifetimeRange;
float3 _InitialSpeedRange;
float3 _ParticleSizeRange;
float3 _InitialRotation;
float3 _RotationRandom;
float3 _AngularVelocity;
float3 _AngularVelocityRandom;

uint Hash(uint value)
{
    value ^= value >> 16;
    value *= 0x7feb352d;
    value ^= value >> 15;
    value *= 0x846ca68b;
    return value ^ (value >> 16);
}

float Random01(inout uint state)
{
    state = Hash(state);
    return (state & 0x00ffffffu) / 16777216.0;
}

float3 RandomDirection(inout uint state)
{
    float z = Random01(state) * 2.0 - 1.0;
    float angle = Random01(state) * 6.28318530718;
    float radius = sqrt(max(0.0, 1.0 - z * z));
    return float3(cos(angle) * radius, sin(angle) * radius, z);
}

float SampleRange(float3 minMaxPower, inout uint state)
{
    float t = pow(Random01(state), max(0.0001, minMaxPower.z));
    return lerp(minMaxPower.x, minMaxPower.y, t);
}

float3 RandomSigned3(inout uint state)
{
    return float3(Random01(state), Random01(state), Random01(state)) * 2.0 - 1.0;
}

void Respawn(inout ParticleData particle, uint id, float ageOffset)
{
    uint state = Hash(id + (uint)_Seed * 747796405u + 2891336453u);
    particle.position = _EmitterOffset +
        (float3(Random01(state), Random01(state), Random01(state)) - 0.5) * _EmitterSize;
    particle.velocity = RandomDirection(state) * SampleRange(_InitialSpeedRange, state);
    particle.lifetime = max(0.01, SampleRange(_LifetimeRange, state));
    particle.age = ageOffset;
    particle.color = float4(Random01(state), 1.0, 1.0, 1.0);
    particle.initialSize = max(0.0, SampleRange(_ParticleSizeRange, state));
    particle.size = particle.initialSize;
    particle.rotation = _InitialRotation + RandomSigned3(state) * _RotationRandom;
    particle.angularVelocity = _AngularVelocity + RandomSigned3(state) * _AngularVelocityRandom;
    particle.alive = 1u;
    particle.seed = state;
}

[numthreads(256, 1, 1)]
void ResetParticles(uint id : SV_DispatchThreadID)
{
    if (id >= (uint)_ParticleCapacity) return;
    ParticleData particle = (ParticleData)0;
    uint state = Hash(id + (uint)_Seed);
    Respawn(particle, id, Random01(state) * max(0.01, _LifetimeRange.y));
    _Particles[id] = particle;
}

float3 CurlLikeField(float3 position, float time, float frequency)
{
    float3 p = position * frequency;
    float t = time * _Speed;
    return float3(
        sin(p.y + t) - cos(p.z * 1.17 - t),
        sin(p.z - t * 0.73) - cos(p.x + t),
        sin(p.x + t * 1.13) - cos(p.y - t * 0.91));
}

[numthreads(256, 1, 1)]
void ApplyModule(uint id : SV_DispatchThreadID)
{
    if (id >= (uint)_ParticleCapacity) return;
    ParticleData particle = _Particles[id];
    if (particle.alive == 0u) return;

    if (_ModuleType == 0) // Integrate
    {
        particle.position += particle.velocity * _DeltaTime * _Strength;
        particle.rotation += particle.angularVelocity * _DeltaTime * _Strength;
        particle.age += _DeltaTime;
        if (particle.age >= particle.lifetime)
            Respawn(particle, id, fmod(particle.age, max(0.01, particle.lifetime)));
    }
    else if (_ModuleType == 1) // Gravity / constant acceleration
    {
        particle.velocity += _Vector * (_Strength * _DeltaTime);
    }
    else if (_ModuleType == 2) // Drag
    {
        particle.velocity *= exp(-max(0.0, _Strength) * _DeltaTime);
    }
    else if (_ModuleType == 3) // Curl-like noise
    {
        float frequency = max(0.0001, abs(_ScaleValue));
        particle.velocity += CurlLikeField(particle.position, _TimeValue, frequency) * (_Strength * _DeltaTime);
    }
    else if (_ModuleType == 4) // Attractor
    {
        float3 delta = _Vector - particle.position;
        float distance = max(0.001, length(delta));
        float falloff = pow(distance, -max(0.0, _ScaleValue));
        particle.velocity += delta / distance * (_Strength * falloff * _DeltaTime);
    }
    else if (_ModuleType == 5) // Generic modulation
    {
        float3 value = _Vector * _Strength;
        if (_Target == 0) particle.position += value * _DeltaTime;
        else if (_Target == 1) particle.velocity += value * _DeltaTime;
        else particle.size = max(0.0, particle.size + value.x * _DeltaTime);
    }
    else if (_ModuleType == 6) // Wrap bounds
    {
        float3 size = max(abs(_Vector), 0.0001);
        particle.position = _EmitterOffset +
            fmod(particle.position - _EmitterOffset + size * 0.5 + size * 8.0, size) - size * 0.5;
    }
    else if (_ModuleType == 7) // Color / opacity over life
    {
        float t = saturate(particle.age / max(0.01, particle.lifetime));
        particle.color.r = t;
        particle.color.a = pow(saturate(1.0 - t), max(0.01, _Strength));
    }
    else if (_ModuleType == 8) // Size over life
    {
        float t = saturate(particle.age / max(0.01, particle.lifetime));
        particle.size = max(0.0, particle.initialSize *
            pow(max(0.0, sin(t * 3.14159265)), max(0.01, _Secondary)) * _Strength);
    }
    else if (_ModuleType == 9) // Lorenz attractor vector field
    {
        float3 p = particle.position - _Vector;
        float sigma = max(0.0, _ScaleValue);
        float rho = _Speed;
        float beta = max(0.0, _Secondary);
        float3 field = float3(
            sigma * (p.y - p.x),
            p.x * (rho - p.z) - p.y,
            p.x * p.y - beta * p.z);
        particle.position += field * (_Strength * _DeltaTime);
    }
    else if (_ModuleType == 10) // Vortex / orbit around a point and axis
    {
        float3 axis = length(_Axis) > 0.0001 ? normalize(_Axis) : float3(0.0, 1.0, 0.0);
        float3 fromCenter = particle.position - _Vector;
        float3 radial = fromCenter - axis * dot(fromCenter, axis);
        float distance = length(radial);
        if (distance > 0.0001)
        {
            float3 radialDirection = radial / distance;
            float3 tangent = cross(axis, radialDirection);
            float falloff = pow(distance, -max(0.0, _Speed));
            float3 force = tangent * _Strength - radialDirection * _ScaleValue;
            particle.velocity += force * (falloff * _DeltaTime);
        }
    }

    _Particles[id] = particle;
}

#pragma kernel ResetParticles
#pragma kernel ApplyModule
#pragma kernel InitializeTrails
#pragma kernel RecordTrails
#pragma kernel CopyBoidSnapshot
#pragma kernel ApplyBoids

#include "../Shaders/Includes/AetherinCurlNoise.hlsl"

struct ParticleData
{
    float3 position;
    float age;
    float3 velocity;
    float lifetime;
    float4 color;
    float size;
    float initialSize;
    float3 rotation;
    float3 angularVelocity;
    uint alive;
    uint seed;
    uint generation;
};

RWStructuredBuffer<ParticleData> _Particles;
RWStructuredBuffer<ParticleData> _BoidParticles;

struct TrailSample
{
    float3 position;
    uint seed;
};

RWStructuredBuffer<TrailSample> _TrailSamples;
int _ParticleCapacity;
int _TrailLength;
int _TrailFrameIndex;
int _ModuleType;
int _Target;
int _Seed;
float _DeltaTime;
float _TimeValue;
float _Strength;
float3 _Vector;
float3 _Axis;
float _ScaleValue;
float _Speed;
float _Secondary;
float3 _BoidNeighborRadii;
int _BoidNeighborSearchMode;
float _BoidFieldOfView;
float3 _BoidWeights;
float3 _BoidMaxForces;
float _BoidMaxSpeed;
float _BoidMaxAcceleration;
int _BoidNeighborSamples;
int _BoidSeparationUsesFieldOfView;
float _OverLifeCurve[64];
float3 _EmitterOffset;
float3 _EmitterSize;
float3 _LifetimeRange;
float3 _InitialSpeedRange;
float3 _ParticleSizeRange;
float3 _InitialRotation;
float3 _RotationRandom;
float3 _AngularVelocity;
float3 _AngularVelocityRandom;

uint Hash(uint value)
{
    value ^= value >> 16;
    value *= 0x7feb352d;
    value ^= value >> 15;
    value *= 0x846ca68b;
    return value ^ (value >> 16);
}

float Random01(inout uint state)
{
    state = Hash(state);
    return (state & 0x00ffffffu) / 16777216.0;
}

float3 RandomDirection(inout uint state)
{
    float z = Random01(state) * 2.0 - 1.0;
    float angle = Random01(state) * 6.28318530718;
    float radius = sqrt(max(0.0, 1.0 - z * z));
    return float3(cos(angle) * radius, sin(angle) * radius, z);
}

float SampleRange(float3 minMaxPower, inout uint state)
{
    float t = pow(Random01(state), max(0.0001, minMaxPower.z));
    return lerp(minMaxPower.x, minMaxPower.y, t);
}

float3 RandomSigned3(inout uint state)
{
    return float3(Random01(state), Random01(state), Random01(state)) * 2.0 - 1.0;
}

float EvaluateOverLifeCurve(float t)
{
    float position = saturate(t) * 63.0;
    uint index = min((uint)floor(position), 63u);
    uint nextIndex = min(index + 1u, 63u);
    return lerp(_OverLifeCurve[index], _OverLifeCurve[nextIndex], frac(position));
}

void Respawn(inout ParticleData particle, uint id, float ageOffset)
{
    particle.generation += 1u;
    uint state = Hash(id + (uint)_Seed * 747796405u + 2891336453u);
    particle.position = _EmitterOffset +
        (float3(Random01(state), Random01(state), Random01(state)) - 0.5) * _EmitterSize;
    particle.velocity = RandomDirection(state) * SampleRange(_InitialSpeedRange, state);
    particle.lifetime = max(0.01, SampleRange(_LifetimeRange, state));
    particle.age = ageOffset;
    particle.color = float4(Random01(state), 1.0, 1.0, 1.0);
    particle.initialSize = max(0.0, SampleRange(_ParticleSizeRange, state));
    particle.size = particle.initialSize;
    particle.rotation = _InitialRotation + RandomSigned3(state) * _RotationRandom;
    particle.angularVelocity = _AngularVelocity + RandomSigned3(state) * _AngularVelocityRandom;
    particle.alive = 1u;
    particle.seed = state;
}

[numthreads(256, 1, 1)]
void ResetParticles(uint id : SV_DispatchThreadID)
{
    if (id >= (uint)_ParticleCapacity) return;
    ParticleData particle = (ParticleData)0;
    uint state = Hash(id + (uint)_Seed);
    Respawn(particle, id, Random01(state) * max(0.01, _LifetimeRange.y));
    _Particles[id] = particle;
}

[numthreads(256, 1, 1)]
void ApplyModule(uint id : SV_DispatchThreadID)
{
    if (id >= (uint)_ParticleCapacity) return;
    ParticleData particle = _Particles[id];
    if (particle.alive == 0u) return;

    if (_ModuleType == 0) // Integrate
    {
        particle.position += particle.velocity * _DeltaTime * _Strength;
        particle.rotation += particle.angularVelocity * _DeltaTime * _Strength;
        particle.age += _DeltaTime;
        if (particle.age >= particle.lifetime)
            Respawn(particle, id, fmod(particle.age, max(0.01, particle.lifetime)));
    }
    else if (_ModuleType == 1) // Gravity / constant acceleration
    {
        particle.velocity += _Vector * (_Strength * _DeltaTime);
    }
    else if (_ModuleType == 2) // Drag
    {
        particle.velocity *= exp(-max(0.0, _Strength) * _DeltaTime);
    }
    else if (_ModuleType == 3) // Simplex curl noise
    {
        float frequency = max(0.0001, abs(_ScaleValue));
        particle.velocity += AetherinCurlNoise(particle.position, _TimeValue, frequency, _Speed) *
            (_Strength * _DeltaTime);
    }
    else if (_ModuleType == 4) // Attractor
    {
        float3 delta = _Vector - particle.position;
        float distance = max(0.001, length(delta));
        float falloff = pow(distance, -max(0.0, _ScaleValue));
        particle.velocity += delta / distance * (_Strength * falloff * _DeltaTime);
    }
    else if (_ModuleType == 5) // Generic modulation
    {
        float3 value = _Vector * _Strength;
        if (_Target == 0) particle.position += value * _DeltaTime;
        else if (_Target == 1) particle.velocity += value * _DeltaTime;
        else particle.size = max(0.0, particle.size + value.x * _DeltaTime);
    }
    else if (_ModuleType == 6) // Wrap bounds
    {
        float3 size = max(abs(_Vector), 0.0001);
        float3 positionBeforeWrap = particle.position;
        float3 relative = particle.position - _EmitterOffset + size * 0.5;
        // HLSL fmod keeps the dividend's sign. The previous fixed +8-cell offset
        // therefore stopped wrapping particles that travelled farther in the
        // negative direction, allowing them to reach and cross the camera.
        relative -= floor(relative / size) * size;
        particle.position = _EmitterOffset + relative - size * 0.5;
        if (any(abs(particle.position - positionBeforeWrap) > 0.0001))
            particle.generation += 1u;
    }
    else if (_ModuleType == 7) // Color / opacity over life
    {
        float t = saturate(particle.age / max(0.01, particle.lifetime));
        particle.color.r = t;
        particle.color.a = saturate(EvaluateOverLifeCurve(t));
    }
    else if (_ModuleType == 8) // Size over life
    {
        float t = saturate(particle.age / max(0.01, particle.lifetime));
        particle.size = max(0.0, particle.initialSize * EvaluateOverLifeCurve(t));
    }
    else if (_ModuleType == 9) // Lorenz attractor vector field
    {
        float3 p = particle.position - _Vector;
        float sigma = max(0.0, _ScaleValue);
        float rho = _Speed;
        float beta = max(0.0, _Secondary);
        float3 field = float3(
            sigma * (p.y - p.x),
            p.x * (rho - p.z) - p.y,
            p.x * p.y - beta * p.z);
        particle.position += field * (_Strength * _DeltaTime);
    }
    else if (_ModuleType == 10) // Vortex / orbit around a point and axis
    {
        float3 axis = length(_Axis) > 0.0001 ? normalize(_Axis) : float3(0.0, 1.0, 0.0);
        float3 fromCenter = particle.position - _Vector;
        float3 radial = fromCenter - axis * dot(fromCenter, axis);
        float distance = length(radial);
        if (distance > 0.0001)
        {
            float3 radialDirection = radial / distance;
            float3 tangent = cross(axis, radialDirection);
            float falloff = pow(distance, -max(0.0, _Speed));
            float3 force = tangent * _Strength - radialDirection * _ScaleValue;
            particle.velocity += force * (falloff * _DeltaTime);
        }
    }
    else if (_ModuleType == 11) // Clamp velocity magnitude
    {
        float maxSpeed = max(0.0, _Strength);
        float speedSq = dot(particle.velocity, particle.velocity);
        if (speedSq > maxSpeed * maxSpeed && speedSq > 0.0000001)
            particle.velocity *= maxSpeed * rsqrt(speedSq);
    }
    _Particles[id] = particle;
}

float3 ClampVectorMagnitude(float3 value, float maximum)
{
    maximum = max(0.0, maximum);
    float lengthSq = dot(value, value);
    if (lengthSq > maximum * maximum && lengthSq > 0.0000001)
        return value * (maximum * rsqrt(lengthSq));
    return value;
}

float3 DirectionSteering(float3 direction, float3 currentVelocity, float maxSpeed, float maxForce)
{
    float lengthSq = dot(direction, direction);
    if (lengthSq <= 0.0000001) return 0.0;
    float3 desiredVelocity = direction * (maxSpeed * rsqrt(lengthSq));
    return ClampVectorMagnitude(desiredVelocity - currentVelocity, maxForce);
}

[numthreads(256, 1, 1)]
void ApplyBoids(uint id : SV_DispatchThreadID)
{
    if (id >= (uint)_ParticleCapacity) return;
    ParticleData particle = _Particles[id];
    if (particle.alive == 0u) return;

    float3 radii = max(abs(_BoidNeighborRadii), 0.0);
    float maxRadius = max(radii.x, max(radii.y, radii.z));
    float maxRadiusSq = maxRadius * maxRadius;
    uint sampleCount = (uint)clamp(_BoidNeighborSamples, 1, 32);
    uint candidateCount = _BoidNeighborSearchMode == 1 ? (uint)_ParticleCapacity : sampleCount;
    float3 separation = 0.0;
    float3 alignment = 0.0;
    float3 cohesion = 0.0;
    uint separationNeighbors = 0u;
    uint alignmentNeighbors = 0u;
    uint cohesionNeighbors = 0u;
    uint state = Hash(particle.seed ^ (id * 747796405u) ^ (uint)_TimeValue);
    float speedSq = dot(particle.velocity, particle.velocity);
    float minViewDot = cos(radians(clamp(_BoidFieldOfView, 0.0, 360.0) * 0.5));
    bool hasViewDirection = speedSq > 0.0000001 && _BoidFieldOfView < 359.999;

    for (uint sample = 0u; sample < candidateCount; sample++)
    {
        uint neighborIndex;
        if (_BoidNeighborSearchMode == 1)
        {
            neighborIndex = sample;
        }
        else
        {
            state = Hash(state + sample * 2891336453u);
            neighborIndex = state % (uint)_ParticleCapacity;
        }
        if (neighborIndex == id) continue;
        ParticleData neighbor = _BoidParticles[neighborIndex];
        if (neighbor.alive == 0u) continue;
        float3 delta = neighbor.position - particle.position;
        float distanceSq = dot(delta, delta);
        if (distanceSq < 0.0000001 || distanceSq > maxRadiusSq) continue;

        float distance = sqrt(distanceSq);
        bool inView = !hasViewDirection || dot(particle.velocity, delta) / sqrt(speedSq * distanceSq) >= minViewDot;
        if (distance <= radii.x && (_BoidSeparationUsesFieldOfView == 0 || inView))
        {
            separation -= delta / distanceSq;
            separationNeighbors++;
        }
        if (inView && distance <= radii.y)
        {
            alignment += neighbor.velocity;
            alignmentNeighbors++;
        }
        if (inView && distance <= radii.z)
        {
            cohesion += delta;
            cohesionNeighbors++;
        }
    }

    if (separationNeighbors > 0u || alignmentNeighbors > 0u || cohesionNeighbors > 0u)
    {
        float maxSpeed = max(0.0, _BoidMaxSpeed);
        float3 maxForces = max(_BoidMaxForces, 0.0);
        float3 weights = max(_BoidWeights, 0.0);
        float3 separationForce = 0.0;
        float3 alignmentForce = 0.0;
        float3 cohesionForce = 0.0;

        if (separationNeighbors > 0u)
            separationForce = DirectionSteering(
                separation / separationNeighbors, particle.velocity, maxSpeed, maxForces.x);
        if (alignmentNeighbors > 0u)
        {
            float3 averageVelocity = alignment / alignmentNeighbors;
            float averageSpeedSq = dot(averageVelocity, averageVelocity);
            float3 desiredVelocity = averageSpeedSq > 0.0000001
                ? averageVelocity * (maxSpeed * rsqrt(averageSpeedSq))
                : 0.0;
            alignmentForce = ClampVectorMagnitude(desiredVelocity - particle.velocity, maxForces.y);
        }
        if (cohesionNeighbors > 0u)
            cohesionForce = DirectionSteering(
                cohesion / cohesionNeighbors, particle.velocity, maxSpeed, maxForces.z);

        float3 acceleration = separationForce * weights.x +
            alignmentForce * weights.y + cohesionForce * weights.z;
        acceleration = ClampVectorMagnitude(acceleration, _BoidMaxAcceleration);
        particle.velocity += acceleration * _DeltaTime;
    }

    particle.velocity = ClampVectorMagnitude(particle.velocity, _BoidMaxSpeed);

    _Particles[id] = particle;
}

[numthreads(256, 1, 1)]
void CopyBoidSnapshot(uint id : SV_DispatchThreadID)
{
    if (id >= (uint)_ParticleCapacity) return;
    _BoidParticles[id] = _Particles[id];
}

[numthreads(256, 1, 1)]
void InitializeTrails(uint id : SV_DispatchThreadID)
{
    uint total = (uint)(_ParticleCapacity * _TrailLength);
    if (id >= total) return;
    uint particleIndex = id / (uint)_TrailLength;
    ParticleData particle = _Particles[particleIndex];
    TrailSample sample;
    sample.position = particle.position;
    sample.seed = particle.generation;
    _TrailSamples[id] = sample;
}

[numthreads(256, 1, 1)]
void RecordTrails(uint id : SV_DispatchThreadID)
{
    if (id >= (uint)_ParticleCapacity) return;
    ParticleData particle = _Particles[id];
    uint slot = (uint)_TrailFrameIndex % (uint)_TrailLength;
    uint sampleIndex = id * (uint)_TrailLength + slot;
    TrailSample sample;
    sample.position = particle.position;
    sample.seed = particle.generation;
    _TrailSamples[sampleIndex] = sample;
}
